# Copy to .env.production and fill in the real values. The real file is
# git-ignored — never commit passwords or the JWT secret.

# Server
PORT=4008
FRONTEND_PORT=3008
NODE_ENV=production

# MSSQL — Material Traceability Database
DB_SERVER=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=Material traceability

# Busy ERP Database (read-only)
ERP_DB_SERVER=
ERP_DB_PORT=1433
ERP_DB_USER=
ERP_DB_PASSWORD=
ERP_DB_NAME=BusyComp0006_db12026

# Raise POs in Busy from the Awarded Suppliers page, through Busy's own
# COM API (backend/busy-bridge/busy-bridge.ps1). Requires the Busy 21
# client installed on THIS server (C:\BusyWin). Connection defaults to
# the ERP_DB_* login above; company code format is "Comp0006".
BUSY_PO_PUSH_ENABLED=false
# BUSY_COM_PATH=C:\BusyWin
# BUSY_COM_COMPANY=Comp0006
# BUSY_COM_FY=2026
# BUSY_PO_SERIES=NCF
# BUSY_COMPANY_DB=BusyComp0006_db

# JWT — use a long random value
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Public application URL (tokenized supplier RFQ links); must be reachable
# from outside the LAN.
APP_URL=

# RFQ token lifetime (days) before the supplier submit link expires.
RFQ_TOKEN_EXPIRY_DAYS=7

# SMTP (RFQ emails to suppliers, Ops manager notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OPS_MANAGER_EMAIL=
REQUISITION_OPS_MANAGER_EMAIL=
